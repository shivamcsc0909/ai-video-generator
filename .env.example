# =============================================================================
# LOCAL AI VIDEO PRODUCTION STUDIO — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Provider API keys should primarily be managed through the application's
# secure UI (Settings → AI Providers), NOT via this file.
# =============================================================================

# --- Application ---
APP_NAME="AI Video Studio"
APP_ENV=development
APP_PORT=8000
SECRET_KEY=                      # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DEBUG=false

# --- Credential Encryption ---
# CRITICAL: This key encrypts all API keys stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this separately from the database backup.
ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://videostudio:videostudio@localhost:5432/videostudio
DATABASE_SYNC_URL=postgresql://videostudio:videostudio@localhost:5432/videostudio

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
STORAGE_BASE_PATH=./storage
PROJECTS_PATH=./storage/projects
ASSETS_PATH=./storage/assets
RENDERS_PATH=./storage/renders
TEMP_PATH=./storage/temp
MODELS_PATH=./models

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- ComfyUI (Local) ---
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=false

# --- Local Model Settings ---
LOCAL_LLM_URL=http://localhost:11434   # Ollama
LOCAL_LLM_MODEL=llama3.1:8b
WHISPER_MODEL=base                     # tiny, base, small, medium, large-v3
LOCAL_TTS_ENGINE=coqui                 # coqui or kokoro

# --- External Provider API Keys (optional — prefer using UI) ---
# These are read as fallback defaults only. The UI-managed encrypted keys take priority.
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# --- Hardware ---
FORCE_CPU=false
MAX_CONCURRENT_JOBS=2               # Adjust based on RAM/GPU

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/studio.log

# --- Auth ---
# For local single-user mode
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                     # Set on first run via setup wizard
JWT_EXPIRE_MINUTES=10080            # 7 days

